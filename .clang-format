---
# Describes the style the tree is already written in: Allman braces, 4-space
# indent, indented namespace bodies, 120 columns. The tree has not been
# bulk-reformatted against it, so format the lines you change, not whole files.
BasedOnStyle: Microsoft
AccessModifierOffset: -4
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
SortIncludes: Never
PointerAlignment: Left
ReferenceAlignment: Left
NamespaceIndentation: All
FixNamespaceComments: false
BreakBeforeBraces: Allman
IndentCaseLabels: false
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AlignAfterOpenBracket: BlockIndent
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
BinPackArguments: false
BinPackParameters: false
BreakBeforeTernaryOperators: true
AlignOperands: Align
AlignTrailingComments: false
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
Cpp11BracedListStyle: true
SpaceAfterTemplateKeyword: true
