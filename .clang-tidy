# Conservative, high-signal static analysis for the engine sources.
#
# The set is intentionally narrow to start: correctness-leaning checks
# (bugprone/performance) plus a few modernizations, with the noisier opinionated
# families (readability naming, magic numbers, trailing-return, etc.) disabled.
# WarningsAsErrors is empty and CI does not run it yet, so it is report-only;
# tighten once the existing tree is clean.
Checks: >
  bugprone-*,
  performance-*,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-use-emplace,
  modernize-loop-convert,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -performance-avoid-endl

WarningsAsErrors: ''

# Only diagnose our own code; vendored libraries live under ThirdParty/.
HeaderFilterRegex: '.*/(Engine|Sandbox|Editor|Tests)/.*'

FormatStyle: file
